# Local secrets and machine-specific environment files
.env
.env.*
!.env.example

# Frontend generated files
frontend/node_modules/
frontend/dist/

# Local wheels and offline caches
backend/python_wheels/

# Large local installers
third_party/htcondor/*.msi

# Temporary files
*.tmp
~$*
.DS_Store
Thumbs.db

