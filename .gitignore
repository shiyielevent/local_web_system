# IDE
.idea/
.vscode/

# Python cache
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Backend virtual environments
backend/.venv/
backend/.venv_*/
backend/.venv_backup_*/
backend/module_envs/

# Local application data and installed modules
backend/data/
backend/installed_modules/

# Runtime, per-user runtime and logs
backend/runtime/
backend/runtime_user/
backend/logs/
*.log

# Local module drop directories
module_drop/
